# PhotoParser API Environment Variables

# PostgreSQL Database Connection
# Use pg8000 driver for migrations, asyncpg for app
DATABASE_URL=postgresql+pg8000://photoparserx:yourpassword@localhost:5432/photoparser

# Redis Connection for RQ Job Queue
REDIS_URL=redis://localhost:6379/0

# FastAPI Settings (optional)
# APP_ENV=development
# LOG_LEVEL=info
